<!DOCTYPE html>
[%
  INCLUDE 'include/doc-head-copyright.inc.tt2'
  author_year='2025'
  author_name='PerplexedTheta'
%]
[% INCLUDE 'include/doc-head-start.inc.tt2' %]
<base href="/">
[%
  INCLUDE 'include/doc-head-close.inc.tt2'
  id="arrivees"
  class="$greyscale"
%]

<div id="loading">
    <span class="dialogue">Loading . . . </span>
</div>

<header>
    <div id="header-left">
        <img src="./res/vectors/br.svg" />
        <h1>&nbsp;</h1>
    </div>
    <div id="clock">
        <span>00 00</span>
        <small>00</small>
    </div>
</header>

<main></main>

<footer>
    <div id="incident">
        <p>&nbsp;</p>
    </div>
</footer>

[% INCLUDE 'include/doc-body-scripts.inc.tt2' %]
<script type="module">
    import API from './include/js/rail/uk/tiger-api.mjs';
    import Clock from './include/js/clock.mjs';
    import UKRail from './include/js/rail/uk/main.mjs';

    const api = new API({ jquery: jQuery });
    api.init();

    const clock = new Clock({ jquery: jQuery, hideSecs: [% IF (hide_secs) %]true[% ELSE %]false[% END %] });
    clock.init();

    const ukrail = new UKRail({
        mode: 'arrivees',
        tiplocId: '[% tiploc_id %]',
        api: api,
        jquery: jQuery,
        hideCalls: [% IF (hide_calls) %]true[% ELSE %]false[% END %],
    });
    ukrail.init();
    setInterval(
        (() => {
            return ukrail.build();
        }),
        30000
    );
</script>
[% INCLUDE 'include/doc-body-close.inc.tt2' %]
